{
  "compilerOptions": {
    "target": "ES2020",
    "module": "none",
    "moduleResolution": "classic",
    "lib": ["ES2020", "DOM"],
    "strict": true,
    "noImplicitAny": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "rootDir": "src",
    "outDir": "dist",
    "sourceMap": false,
    "declaration": false
  },
  "include": ["src/**/*.ts"],
  "exclude": ["dist", "www", "android", "ios"]
}
