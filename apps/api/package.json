{
  "name": "@gach/api",
  "version": "1.0.0",
  "private": true,
  "description": "GitHub Achievement Hub — REST API (NestJS + Prisma + PostgreSQL)",
  "scripts": {
    "dev": "node --watch-path=src -r ts-node/register/transpile-only src/main.ts",
    "dev:once": "ts-node --transpile-only src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "seed": "ts-node --transpile-only src/scripts/seed.ts",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --config jest.config.js --forceExit",
    "test:unit": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --config jest.config.js --testPathPatterns=test/unit",
    "test:e2e": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --config jest.config.js --runInBand --forceExit --testPathPatterns=test/e2e",
    "test:cov": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --config jest.config.js --coverage --forceExit",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "prisma": {
    "seed": "tsx src/scripts/seed.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.15",
    "@electric-sql/pglite-socket": "0.2.18",
    "@nestjs/common": "12.4.0",
    "@nestjs/config": "12.1.1",
    "@nestjs/core": "12.4.0",
    "@nestjs/jwt": "12.0.4",
    "@nestjs/passport": "12.0.1",
    "@nestjs/platform-express": "12.4.0",
    "@nestjs/schedule": "12.0.3",
    "@nestjs/swagger": "12.1.1",
    "@nestjs/throttler": "6.7.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "bcryptjs": "3.0.3",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "compression": "1.8.2",
    "cookie-parser": "1.4.7",
    "helmet": "8.3.0",
    "ioredis": "6.0.0",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "passport-local": "1.0.0",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "swagger-ui-express": "5.0.1"
  },
  "devDependencies": {
    "@nestjs/testing": "12.4.0",
    "@types/bcryptjs": "3.0.0",
    "@types/compression": "1.8.1",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "22.20.5",
    "@types/passport-jwt": "4.0.1",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "cross-env": "10.1.0",
    "jest": "30.5.2",
    "node": "24.22.2",
    "prisma": "7.10.1",
    "supertest": "7.3.2",
    "ts-jest": "29.4.15",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
