# ============================================================================
# GitHub Achievement Hub — 环境变量模板
# 复制为 .env 后按需修改：cp .env.example .env
# ============================================================================

# ---------- 运行环境 ----------
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
# 允许跨域的前端地址（多个用逗号分隔）
WEB_ORIGIN=http://localhost:3000,http://localhost:3001
# OAuth 原生壳可回调到 tauri://localhost / https://localhost，后端会限制在固定白名单
# 站点公开地址，用于生成 OAuth 回调与分页链接
SITE_URL=http://localhost:4000

# ---------- 数据库 ----------
# DB_PROVIDER:
#   pglite  → 本地开发。API 内嵌一个 PostgreSQL 兼容实例（无需安装 Postgres/Docker）
#   postgres→ 生产环境，连接标准 PostgreSQL
DB_PROVIDER=pglite

DB_NAME=github_achievement_hub
DB_USER=postgres
DB_PASSWORD=postgres
DB_PORT=5432
DB_HOST=127.0.0.1

# 生产环境必填：postgresql://user:pass@host:5432/dbname?schema=public
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55432/postgres

# 仅 DB_PROVIDER=pglite 时生效
PGLITE_DATA_DIR=./.pglite
PGLITE_PORT=55432
# 默认拒绝复用已有监听，防止连接到其他项目的数据库；仅在确认归属时显式开启
PGLITE_REUSE_EXTERNAL=false
# 开发环境自动执行无损 prisma db push；遇到数据丢失风险时拒绝启动（生产环境请使用 migration）
DB_AUTO_PUSH=true
# 开发环境数据库为空时自动灌入种子数据
DB_AUTO_SEED=true

# ---------- Redis（可选） ----------
# 留空则自动降级为进程内 LRU 缓存，不影响功能
REDIS_URL=
CACHE_TTL_SECONDS=300

# ---------- 认证 ----------
# 生产环境务必替换为强随机值：openssl rand -base64 48
# 生产环境务必替换为强随机值；开发环境也请使用本机独有值
JWT_SECRET=replace-with-a-long-random-jwt-secret
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=replace-with-a-long-random-refresh-secret
REFRESH_TOKEN_TTL_DAYS=30
# 用于加密存储 GitHub access token 的 32 字节密钥（hex 或 base64）
TOKEN_ENCRYPTION_KEY=replace-with-64-hex-characters

# 管理员初始账号（首次种子时创建）
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password
ADMIN_NAME=站点管理员

# ---------- GitHub 集成 ----------
# 在 https://github.com/settings/developers 创建 OAuth App
# Homepage URL: http://localhost:3000
# Authorization callback URL: http://localhost:4000/api/v1/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:4000/api/v1/auth/github/callback
# 可选：提高 GitHub API 速率限制的服务端 token（仅服务端使用）
GITHUB_TOKEN=
# GitHub API 请求间隔（毫秒），用于遵守速率限制
GITHUB_API_MIN_INTERVAL_MS=220

# ---------- 内容与站点 ----------
SITE_NAME=GitHub Achievement Hub
SITE_DESCRIPTION=GitHub 个人成就勋章百科与获取指南平台
SITE_NAME_ZH=GitHub 成就勋章百科
ADMIN_CONTACT_EMAIL=admin@gach.local

# GitHub upstream timeout, milliseconds (100–30000; invalid values use 10000)
GITHUB_API_TIMEOUT_MS=10000
