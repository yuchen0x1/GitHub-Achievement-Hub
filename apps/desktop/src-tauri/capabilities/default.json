{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "GitHub Achievement Hub 桌面端主窗口的最小权限集",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "store:default",
    "process:default",
    "shell:allow-open",
    "updater:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://*" },
        { "url": "http://localhost:*" },
        { "url": "http://127.0.0.1:*" }
      ]
    }
  ]
}
