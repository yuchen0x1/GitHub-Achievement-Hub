{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GitHub Achievement Hub",
  "version": "1.0.0",
  "identifier": "com.gach.hub",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm --prefix ../.. run dev:web",
    "beforeBuildCommand": "node scripts/prepare-dist.mjs"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "GitHub Achievement Hub",
        "width": 1280,
        "height": 860,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "center": true,
        "decorations": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "GitHub Achievement Hub",
    "copyright": "Copyright © 2026 GitHub Achievement Hub",
    "category": "DeveloperTool",
    "shortDescription": "GitHub 成就勋章百科与获取指南",
    "longDescription": "GitHub Achievement Hub 桌面版：浏览 GitHub 成就勋章、获取攻略与进度追踪，支持离线缓存查看。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [],
      "pubkey": "",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
