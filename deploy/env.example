NODE_ENV=production
DB_PROVIDER=postgres
DATABASE_URL=postgresql://user:password@127.0.0.1:5432/github_achievement_hub
PORT=4000
API_PREFIX=/api/v1
WEB_ORIGIN=https://example.com
SITE_URL=https://example.com
DB_AUTO_PUSH=false
DB_AUTO_SEED=false
JWT_SECRET=replace-with-a-long-random-value
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=replace-with-another-long-random-value
REFRESH_TOKEN_TTL_DAYS=30
TOKEN_ENCRYPTION_KEY=replace-with-64-hex-characters
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_NAME=站点管理员
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=https://example.com/api/v1/auth/github/callback
GITHUB_TOKEN=
GITHUB_API_MIN_INTERVAL_MS=220
