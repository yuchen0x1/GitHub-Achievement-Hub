GACH_REPOSITORY=yuchen0x1/GitHub-Achievement-Hub
GACH_DEPLOY_ROOT=/srv/github-achievement-hub
GACH_API_INTERNAL_URL=http://127.0.0.1:4000/api/v1
# 构建期数据读取用临时 API，不可与运行期 rewrite 地址混用
GACH_BUILD_API_PORT=4100
GACH_BUILD_API_INTERNAL_URL=http://127.0.0.1:4100/api/v1
GACH_API_HEALTH_URL=http://127.0.0.1:4000/api/v1/health
GACH_WEB_HEALTH_URL=http://127.0.0.1:3000/healthz
GACH_RELEASE_KEEP=3
GACH_RUN_MIGRATIONS=false
GACH_GITHUB_TOKEN=
GACH_GIT_URL=https://github.com/yuchen0x1/GitHub-Achievement-Hub.git
# 私有仓库可改为 SSH URL，并设置只读 Deploy Key：
# GACH_GIT_URL=git@github.com:yuchen0x1/GitHub-Achievement-Hub.git
# GACH_GIT_SSH_COMMAND="ssh -i /etc/github-achievement-hub/deploy-key -o IdentitiesOnly=yes -o StrictHostKeyChecking=yes"
GACH_USE_SUDO=true
